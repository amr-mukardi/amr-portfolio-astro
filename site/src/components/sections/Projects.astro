---
import Button from '../ui/Buttons.astro';
import { t } from '../../utils/i18n';
import { projects, projectCategories, pick } from '../../data/content';
import { whatsapp_url } from '../../utils/me';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

// أغلفة المشاريع: src/assets/projects/<file>. إن لم يوجد الملف يظهر غلاف بديل.
const covers = import.meta.glob('../../assets/projects/*.{svg,png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' }) as Record<string, any>;
const coverFor = (file: string): string | null => {
  const key = Object.keys(covers).find((k) => k.endsWith('/' + file));
  if (!key) return null;
  const m = covers[key];
  return typeof m === 'string' ? m : m.src;
};

const waHref = `${whatsapp_url}?text=${encodeURIComponent(t('projects.ctaMessage', lang))}`;
const filters = ['all', ...projectCategories];
const countOf = (k: string) => (k === 'all' ? projects.length : projects.filter((p) => p.cat === k).length);
---

<section id="projects" class="py-16 md:py-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-10" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('projects.title', lang)}</h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl">{t('projects.subtitle', lang)}</p>
    </div>

    <div class="flex flex-wrap gap-3 mb-10" role="group" aria-label={t('projects.filterLabel', lang)} data-aos="fade-up">
      {filters.map((key) => (
        <button
          type="button"
          data-filter={key}
          aria-pressed={key === 'all' ? 'true' : 'false'}
          class="filter-btn inline-flex items-center gap-2 px-4 py-2 text-sm font-mono rounded-full transition-colors duration-200 bg-gray-100 dark:bg-gray-800 text-secondary/70 dark:text-white/70 hover:bg-gray-200 dark:hover:bg-gray-700"
        >
          <span>{t(`projects.filters.${key}`, lang)}</span>
          <span class="text-xs opacity-70">{countOf(key)}</span>
        </button>
      ))}
    </div>
    <p id="filter-status" class="sr-only" aria-live="polite" data-template={t('projects.shown', lang)}></p>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8" id="projects-grid">
      {projects.map((project, index) => {
        const cover = coverFor(project.cover);
        const title = pick(project.title, lang);
        return (
          <div
            class="md:col-span-4 group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col"
            data-project-card
            data-cat={project.cat}
            data-aos="fade-up"
            data-aos-delay={(index % 3) * 100}
          >
            <div class="relative overflow-hidden aspect-video">
              {cover ? (
                <img src={cover} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-primary/10 to-orange-400/10 flex items-center justify-center font-heading text-5xl text-primary/60" aria-hidden="true">{Array.from(title)[0]}</div>
              )}
            </div>

            <div class="p-6 flex flex-col flex-grow">
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">{title}</h3>
              <p class="text-secondary/70 dark:text-white/70 mb-5 flex-grow">{pick(project.desc, lang)}</p>
              <div class="flex flex-wrap gap-2 mb-5" dir="ltr">
                {project.tags.map((tag) => (
                  <span class="px-3 py-1 text-xs font-mono bg-primary/10 text-primary rounded-full">{tag}</span>
                ))}
              </div>
              <div class="pt-5 border-t border-gray-100 dark:border-gray-800">
                <Button text={t('projects.viewProject', lang)} href={project.url} target="_blank" variant="outline" size="sm" />
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-14 text-center" data-aos="fade-up">
      <p class="text-secondary/70 dark:text-white/70 max-w-xl mx-auto mb-6">{t('projects.ctaLead', lang)}</p>
      <Button text={t('projects.ctaButtonText', lang)} href={waHref} target="_blank" variant="primary" size="lg" />
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
  const status = document.getElementById('filter-status');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      let shown = 0;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((c) => {
        const show = f === 'all' || c.dataset.cat === f;
        c.hidden = !show;
        if (show) shown++;
      });
      if (status) status.textContent = (status.dataset.template || '').replace('{n}', String(shown));
      (window as any).AOS?.refreshHard?.();
    });
  });
</script>

<style>
  .filter-btn[aria-pressed='true'] {
    background-color: theme('colors.primary');
    color: #fff;
  }
</style>
