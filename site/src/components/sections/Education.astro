---
import { t } from '../../utils/i18n';
import { education, certificates, CERT_PATH, pick } from '../../data/content';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;
const VISIBLE = 4;
const dl = 'inline-flex items-center justify-center gap-1 min-h-[36px] px-3 text-xs font-mono font-medium rounded-lg border border-primary/40 text-primary hover:bg-primary/10 transition-colors duration-200';
---

<section id="education" class="py-16 md:py-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('education.title', lang)}</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div data-aos="fade-up">
        <h3 class="font-heading text-2xl text-secondary dark:text-white mb-6">{t('education.academic', lang)}</h3>
        <div class="space-y-4">
          {education.map((e) => (
            <div class="bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-6 shadow-sm flex items-start justify-between gap-4">
              <div class="min-w-0">
                <span class="font-mono text-primary text-sm block mb-1">{e.year}</span>
                <h4 class="font-heading text-lg text-secondary dark:text-white mb-1">{pick(e.title, lang)}</h4>
                <p class="text-sm text-secondary/70 dark:text-white/70">{pick(e.inst, lang)}</p>
              </div>
              <a href={CERT_PATH + e.file} download class={dl + ' shrink-0'} aria-label={`${t('education.download', lang)} ${pick(e.title, lang)}`}>{t('education.download', lang)}</a>
            </div>
          ))}
        </div>
      </div>

      <div data-aos="fade-up" data-aos-delay="100">
        <h3 class="font-heading text-2xl text-secondary dark:text-white mb-6">{t('education.certs', lang)}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="certs-grid">
          {certificates.map((c, i) => (
            <div class="cert-item bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-4 shadow-sm flex flex-col justify-between" hidden={i >= VISIBLE}>
              <div>
                <span class="inline-block px-2.5 py-1 mb-2 text-xs font-mono bg-primary/10 text-primary rounded-md">{c.spec ? t('education.spec', lang) : t('education.course', lang)}</span>
                <p class="text-sm font-medium text-secondary dark:text-white mb-4">{pick(c.title, lang)}</p>
              </div>
              <div class="flex gap-2 mt-auto" dir="ltr">
                {c.ar && <a href={CERT_PATH + c.ar} download class={dl + ' flex-1'} aria-label={`${t('education.download', lang)} ${c.title.ar} AR`}>AR</a>}
                {c.en && <a href={CERT_PATH + c.en} download class={dl + ' flex-1'} aria-label={`${t('education.download', lang)} ${c.title.en} EN`}>EN</a>}
              </div>
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <button
            id="toggle-certs"
            type="button"
            aria-expanded="false"
            data-all={t('education.showAll', lang).replace('{n}', String(certificates.length))}
            data-less={t('education.showLess', lang)}
            class="inline-flex items-center justify-center rounded-lg font-medium text-sm py-2 px-5 border border-primary text-primary hover:bg-primary/10 transition-colors duration-200"
          >{t('education.showAll', lang).replace('{n}', String(certificates.length))}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('toggle-certs') as HTMLButtonElement | null;
  const items = document.querySelectorAll<HTMLElement>('.cert-item');
  const VISIBLE = 4;
  btn?.addEventListener('click', () => {
    const expand = btn.getAttribute('aria-expanded') !== 'true';
    items.forEach((el, i) => { if (i >= VISIBLE) el.hidden = !expand; });
    btn.setAttribute('aria-expanded', String(expand));
    btn.textContent = expand ? btn.dataset.less || '' : btn.dataset.all || '';
    (window as any).AOS?.refreshHard?.();
  });
</script>
