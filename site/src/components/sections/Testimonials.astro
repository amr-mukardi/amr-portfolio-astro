---
import { QuoteIcon } from '@lucide/astro';
import { t } from '../../utils/i18n';
import { testimonials, pick } from '../../data/content';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;
---

<section id="testimonials" class="py-16 md:py-24">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('testimonials.title', lang)}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {testimonials.map((item, index) => (
        <figure
          class="bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col"
          data-aos="fade-up"
          data-aos-delay={(index % 2) * 100}
        >
          <div class="text-primary bg-primary/5 p-3 rounded-lg self-start mb-5" aria-hidden="true">
            <QuoteIcon size={22} stroke-width={1.75} />
          </div>
          <blockquote class="text-secondary/80 dark:text-white/80 leading-relaxed mb-6 flex-grow">{pick(item.text, lang)}</blockquote>
          <figcaption>
            <span class="font-heading text-secondary dark:text-white block">{item.author}</span>
            <span class="text-sm text-secondary/60 dark:text-white/60">{pick(item.role, lang)}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
