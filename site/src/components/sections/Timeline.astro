---
import { t } from '../../utils/i18n';
import { experience, pick, pickList } from '../../data/content';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;
---

<section id="experience" class="py-16 md:py-24">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('timeline.title', lang)}</h2>
    </div>

    <div id="timeline-container" class="relative">
      <!-- Timeline line -->
      <div class="absolute start-0 md:start-1/2 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-700 transform md:translate-x-px rtl:md:-translate-x-px"></div>

      <div class="space-y-12">
        {experience.map((item, index) => (
          <div
            class={`relative flex flex-col md:flex-row gap-8 md:gap-0 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}
            data-aos={(index % 2 === 0) === (lang === 'en') ? 'fade-left' : 'fade-right'}
          >
            <div class="timeline-dot absolute start-0 md:start-1/2 top-0 w-5 h-5 rounded-full bg-primary border-4 border-white dark:border-neutral-dark transform -translate-x-2 md:-translate-x-2.5 rtl:translate-x-2 rtl:md:translate-x-2.5"></div>

            <div class="md:w-1/2 ps-10 md:ps-0 md:pe-12 md:text-end">
              <span class="font-mono text-primary text-sm block mb-1"><bdi>{index === 0 ? `${item.year} — ${t('timeline.present', lang)}` : item.year}</bdi></span>
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-1">{pick(item.role, lang)}</h3>
              <p class="text-primary/90 text-sm font-medium mb-2">{pick(item.company, lang)}</p>
              <p class="text-secondary/70 dark:text-white/70">{pickList(item.items, lang).join(' ')}</p>
            </div>

            <div class="md:w-1/2 md:ps-12"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    gsap.from(document.querySelectorAll('.timeline-dot'), {
      scrollTrigger: { trigger: '#timeline-container', start: 'top 80%' },
      scale: 0,
      opacity: 0,
      duration: 0.5,
      stagger: 0.2,
      ease: 'back.out(1.7)',
    });
  });
</script>
